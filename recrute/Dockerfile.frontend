FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 4200

# Run Angular dev server accessible from host with file polling for hot reload
CMD ["npm", "start", "--", "--host", "0.0.0.0", "--port", "4200", "--poll=2000"]
